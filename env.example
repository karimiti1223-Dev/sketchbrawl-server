# .envという名前でこのファイルをコピーし、実際の値を入れてください(.envはGitにコミットしないこと)

# Google AI Studio(ai.google.dev)で発行したAPIキー(無料枠で利用)
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Roblox側(HttpService)と共有する合言葉。適当な長いランダム文字列にする
ROBLOX_SHARED_SECRET=change_this_to_a_long_random_string

# サーバーのポート番号(ホスティング先によっては自動設定されるので、その場合は不要)
PORT=3000
